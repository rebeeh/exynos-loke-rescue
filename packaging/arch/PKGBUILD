# Maintainer: Rabeeh Fouz Ahammad VK <rabeeh@users.noreply.github.com>
pkgname=exynos-loke-rescue
pkgver=1.0.0
pkgrel=1
pkgdesc="Deterministic Linux firmware recovery engine for Samsung Exynos SoCs"
arch=('x86_64' 'aarch64')
url="https://github.com/rebeeh/exynos-loke-rescue"
license=('MIT')
depends=('systemd-libs')
makedepends=('cargo' 'rust')
optdepends=(
    'wireshark-cli: For live USB wire telemetry capture'
    'lz4: For manual partition decompression'
)
install=exynos-loke-rescue.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$pkgname-$pkgver"
    cargo build --release --locked
}

check() {
    cd "$pkgname-$pkgver"
    cargo test --release --locked
}

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 "target/release/$pkgname" "$pkgdir/usr/bin/$pkgname"
    install -Dm644 "udev/60-exynos-loke-rescue.rules" "$pkgdir/usr/lib/udev/rules.d/60-exynos-loke-rescue.rules"
    install -Dm644 "target/man/$pkgname.1" "$pkgdir/usr/share/man/man1/$pkgname.1"
    install -Dm644 "target/completions/$pkgname.bash" "$pkgdir/usr/share/bash-completion/completions/$pkgname"
    install -Dm644 "target/completions/_$pkgname" "$pkgdir/usr/share/zsh/site-functions/_$pkgname"
    install -Dm644 "target/completions/$pkgname.fish" "$pkgdir/usr/share/fish/vendor_completions.d/$pkgname.fish"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
