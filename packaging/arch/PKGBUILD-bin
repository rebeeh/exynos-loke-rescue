# Maintainer: Rabeeh Fouz Ahammad VK <rabeeh@users.noreply.github.com>
pkgname=exynos-loke-rescue-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="Deterministic Linux firmware recovery engine for Samsung Exynos SoCs (Precompiled binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/rebeeh/exynos-loke-rescue"
license=('MIT')
provides=('exynos-loke-rescue')
conflicts=('exynos-loke-rescue')
install=exynos-loke-rescue.install
source_x86_64=("$url/releases/download/v$pkgver/exynos-loke-rescue-v$pkgver-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/exynos-loke-rescue-v$pkgver-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 exynos-loke-rescue "$pkgdir/usr/bin/exynos-loke-rescue"
    install -Dm644 udev/60-exynos-loke-rescue.rules "$pkgdir/usr/lib/udev/rules.d/60-exynos-loke-rescue.rules"
    install -Dm644 man/exynos-loke-rescue.1 "$pkgdir/usr/share/man/man1/exynos-loke-rescue.1"
    install -Dm644 completions/exynos-loke-rescue.bash "$pkgdir/usr/share/bash-completion/completions/exynos-loke-rescue"
    install -Dm644 completions/_exynos-loke-rescue "$pkgdir/usr/share/zsh/site-functions/_exynos-loke-rescue"
    install -Dm644 completions/exynos-loke-rescue.fish "$pkgdir/usr/share/fish/vendor_completions.d/exynos-loke-rescue.fish"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
