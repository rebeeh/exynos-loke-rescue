#!/usr/bin/make -f
%:
	dh $@ --buildsystem=cargo

override_dh_auto_build:
	cargo build --release

override_dh_auto_install:
	install -D -m 0755 target/release/exynos-loke-rescue debian/exynos-loke-rescue/usr/bin/exynos-loke-rescue
	install -D -m 0644 udev/60-exynos-loke-rescue.rules debian/exynos-loke-rescue/usr/lib/udev/rules.d/60-exynos-loke-rescue.rules
	install -D -m 0644 target/man/exynos-loke-rescue.1 debian/exynos-loke-rescue/usr/share/man/man1/exynos-loke-rescue.1
	install -D -m 0644 target/completions/exynos-loke-rescue.bash debian/exynos-loke-rescue/usr/share/bash-completion/completions/exynos-loke-rescue
	install -D -m 0644 target/completions/_exynos-loke-rescue debian/exynos-loke-rescue/usr/share/zsh/vendor-completions/_exynos-loke-rescue
	install -D -m 0644 target/completions/exynos-loke-rescue.fish debian/exynos-loke-rescue/usr/share/fish/vendor_completions.d/exynos-loke-rescue.fish
